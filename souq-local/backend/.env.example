# MarGem API environment — copy to .env and customize

APP_NAME=MarGem API
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://souq:souq_local_dev@localhost:5432/souq_local

JWT_SECRET_KEY=generate-a-long-random-secret-at-least-32-chars
# Use a different random 32+ character value from JWT_SECRET_KEY.
UPLOAD_TOKEN_SECRET=generate-a-separate-long-random-upload-token-secret
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
JWT_ISSUER=margem-api
JWT_AUDIENCE=margem-mobile
BCRYPT_ROUNDS=12
LOGIN_LOCKOUT_THRESHOLD=5
STAFF_MFA_REQUIRED=true
MFA_ENCRYPTION_KEY=
AUTH_DEV_BYPASS=false
# Local dev only — enables manual premium activation without NAPS.
ALLOW_MANUAL_BILLING=true

# Platform billing — Dribex service fees only (not buyer↔seller product payments)
# Production: PAYMENT_PROVIDER=naps
PAYMENT_PROVIDER=manual
PAYMENT_CURRENCY=mad

# NAPS ePay (Morocco) — obtain credentials from NAPS merchant integration guide
NAPS_ENVIRONMENT=sandbox
NAPS_MERCHANT_ID=
NAPS_API_KEY=
NAPS_SECRET_KEY=
NAPS_WEBHOOK_SECRET=
NAPS_API_KEY_HEADER=X-API-Key
NAPS_EPAY_PAYMENT_INIT_URL=
NAPS_EPAY_PAYMENT_STATUS_URL=
NAPS_REQUEST_SIGNING_ENABLED=true
NAPS_RESPONSE_PAYMENT_ID_PATH=payment_id
NAPS_RESPONSE_REDIRECT_URL_PATH=redirect_url
NAPS_RESPONSE_STATUS_PATH=status
NAPS_RESPONSE_AMOUNT_PATH=amount
NAPS_RESPONSE_CURRENCY_PATH=currency
NAPS_WEBHOOK_EVENT_ID_FIELD=event_id
NAPS_WEBHOOK_STATUS_FIELD=status
NAPS_WEBHOOK_PAYMENT_ID_FIELD=payment_id
NAPS_WEBHOOK_AMOUNT_FIELD=amount
NAPS_WEBHOOK_CURRENCY_FIELD=currency
NAPS_WEBHOOK_SIGNATURE_HEADER=X-NAPS-Signature
NAPS_WEBHOOK_SUCCESS_STATUSES=success,paid,completed
NAPS_EXTRA_REQUEST_FIELDS_JSON={}

# Active storage provider (default: selfhosted = MinIO on Moroccan infrastructure)
STORAGE_PROVIDER=selfhosted
# Deprecated alias — use STORAGE_PROVIDER instead
STORAGE_BACKEND=minio

# Self-hosted MinIO (internal Docker network in production)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=margem-media
MINIO_BUCKET_PROFILES=dribex-profiles
MINIO_BUCKET_PRODUCTS=dribex-products
MINIO_BUCKET_LISTINGS=dribex-listings
MINIO_BUCKET_PRIVATE=dribex-private
MINIO_PUBLIC_URL=
MINIO_REGION=

# Azure Blob — inactive unless STORAGE_PROVIDER=azure
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=margem-media

CORS_ORIGINS=["http://localhost:3000","http://10.0.2.2:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","10.0.2.2"]

RATE_LIMIT=300/minute
AUTH_RATE_LIMIT=30/minute
MAX_REQUEST_BODY_BYTES=1048576

# Optional shared rate-limit store (required when running >1 API replica)
REDIS_URL=

# Set to 1+ when behind Azure ACA / reverse proxy so rate limits use X-Forwarded-For
TRUSTED_PROXY_HOPS=0
# Optional extra hosts allowed in presigned upload URLs (comma-separated)
UPLOAD_ALLOWED_HOSTS=

# Transactional email (required in production unless ALLOW_INSECURE_EMAIL_FALLBACK=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=MarGem <noreply@margem.ma>
SMTP_USE_TLS=true
ALLOW_INSECURE_EMAIL_FALLBACK=false

# Used in password-reset / email-verify links opened by the mobile app
PUBLIC_APP_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:8000

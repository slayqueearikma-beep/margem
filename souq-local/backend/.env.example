# Dribex API — local development environment template
# Copy to backend/.env (never commit real secrets)

APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://souq:souq_local_dev@localhost:5432/souq_local

# Auth — rotate all three keys before any shared/staging deployment
JWT_SECRET_KEY=local-dev-secret-change-in-production-min-32-chars
UPLOAD_TOKEN_SECRET=local-dev-upload-token-secret-change-in-production-min-32-chars
MFA_ENCRYPTION_KEY=local-dev-mfa-encryption-key-change-in-production-32
AUTH_DEV_BYPASS=false

# Google Sign-In — comma-separated OAuth client IDs for server-side ID token verification
# (include Web + Android + iOS client IDs from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_IDS=CHANGE_ME_WEB_CLIENT_ID.apps.googleusercontent.com
ALLOW_MANUAL_BILLING=true

# Storage — local filesystem for dev; use selfhosted/azure in staging/production
STORAGE_PROVIDER=local
LOCAL_MEDIA_ROOT=./data/media
PUBLIC_API_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:3000

# CORS / host allowlists — development only (localhost appended automatically)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Email — Brevo API (official provider; never commit BREVO_API_KEY)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@dribex.ma
BREVO_SENDER_NAME=Dribex
EMAIL_REPLY_TO=support@dribex.ma
EMAIL_SEND_TIMEOUT_SECONDS=20
EMAIL_MAX_RETRIES=2
EMAIL_RETRY_DELAY_SECONDS=0.75
# Development only — logs redacted email previews instead of sending
ALLOW_INSECURE_EMAIL_FALLBACK=false

# Payments — manual billing allowed in development only
PAYMENT_PROVIDER=manual
NAPS_ENVIRONMENT=sandbox

# Admin — separate dashboard container recommended in production
SERVE_EMBEDDED_ADMIN=true
ADMIN_DASHBOARD_DIR=
ADMIN_REQUIRE_STAFF_MFA=false
ADMIN_IP_ALLOWLIST=

# Rate limiting — set REDIS_URL in staging/production for multi-replica deployments
REDIS_URL=

# Optional telemetry
SENTRY_DSN=

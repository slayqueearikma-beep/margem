# Copy to .env.local for local development:
#   cp env.example .env.local

# --- Same machine (browser on the server) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://127.0.0.1:8000

# --- LAN / phone / another PC (replace with your server IP, e.g. 192.168.11.104) ---
# NEXT_PUBLIC_SITE_URL=http://192.168.11.104:3000
# NEXT_PUBLIC_API_BASE_URL=http://192.168.11.104:8000
# API_BASE_URL=http://127.0.0.1:8000

NEXT_PUBLIC_LAUNCH_CITIES=Casablanca

# Dev server bind (do not change unless port 3000 is taken)
WEB_DEV_HOST=0.0.0.0
WEB_DEV_PORT=3000

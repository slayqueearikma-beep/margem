# Copy to android/local.properties (gitignored) and add your Maps key:
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key
#
# Linux: if Gradle picks the wrong JDK, add (adjust path to your JDK 17 install):
# org.gradle.java.home=/usr/lib/jvm/java-17-openjdk-amd64

sdk.dir=C\:\\Users\\YOUR_USER\\AppData\\Local\\Android\\sdk
GOOGLE_MAPS_API_KEY=

# Production — advertising-first launch (no NAPS / no payments required)
# Copy to .env.production on production server (never commit)

APP_ENV=production
DEBUG=false
DATABASE_URL=postgresql+asyncpg://margem:CHANGE_ME_STRONG@postgres:5432/margem
JWT_SECRET_KEY=CHANGE_ME_PRODUCTION_JWT_32_CHARS_MINIMUM
UPLOAD_TOKEN_SECRET=CHANGE_ME_PRODUCTION_UPLOAD_SECRET_32
MFA_ENCRYPTION_KEY=CHANGE_ME_PRODUCTION_MFA_KEY_32_CHARS
STORAGE_PROVIDER=selfhosted
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME_STRONG
MINIO_PUBLIC_URL=https://media.dribex.ma
PUBLIC_API_URL=https://api.dribex.ma
PUBLIC_APP_URL=https://dribex.ma
QR_PUBLIC_BASE_URL=https://qr.dribex.ma
CORS_ORIGINS=https://dribex.ma,https://www.dribex.ma
ALLOWED_HOSTS=api.dribex.ma,dribex.ma,www.dribex.ma,qr.dribex.ma
TRUSTED_PROXY_HOPS=1
REDIS_URL=redis://redis:6379/0

# Monetization — initial launch
PAYMENTS_ENABLED=false
SUBSCRIPTIONS_ENABLED=false
ADS_ENABLED=true
REWARDED_ADS_ENABLED=false
REWARDED_AD_SIGNING_SECRET=CHANGE_ME_REWARDED_AD_SIGNING_SECRET_32
PAYMENT_PROVIDER=none
LISTING_VIDEO_UPLOADS_ENABLED=false

# Email (required)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=CHANGE_ME_BREVO_API_KEY
BREVO_SENDER_EMAIL=noreply@dribex.ma
BREVO_SENDER_NAME=Dribex
EMAIL_REPLY_TO=support@dribex.ma
ALLOW_INSECURE_EMAIL_FALLBACK=false

# Admin / security
ADMIN_IP_ALLOWLIST=YOUR_OFFICE_OR_VPN_CIDR
ADMIN_REQUIRE_STAFF_MFA=true
SERVE_EMBEDDED_ADMIN=false

# Monitoring (optional)
SENTRY_DSN=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Future payment provider (inactive while PAYMENTS_ENABLED=false)
# NAPS_MERCHANT_ID=
# NAPS_API_KEY=
# NAPS_SECRET_KEY=
# NAPS_WEBHOOK_SECRET=
# NAPS_EPAY_PAYMENT_INIT_URL=
# NAPS_EPAY_PAYMENT_STATUS_URL=

FREE_SELLER_VIDEO_LIMIT=5

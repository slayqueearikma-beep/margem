  networking      = false
  keyvault        = false
  postgresql      = false
  storage         = false
  monitoring      = false
  security        = false
  aks             = false
  appservice      = false
  apim            = false
  frontdoor       = false
  redis           = false
  servicebus      = false
  messaging       = false
  search          = false
  ai              = false
  ddos_protection = false
  firewall        = false
  multi_region    = false
}

common_tags = {
  project    = "margem"

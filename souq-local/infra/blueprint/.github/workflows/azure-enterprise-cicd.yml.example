# Example only — NOT active. Do not enable without renaming to .github/workflows/
#
# Enterprise CI/CD for MarGem Azure blueprint.
# Current production CI remains: .github/workflows/margem-ci.yml

name: MarGem Enterprise Blueprint CI/CD (EXAMPLE)

on:
  workflow_dispatch: # Manual only — never auto-trigger
    inputs:
      environment:
        description: Target environment
        required: true
        default: staging
        type: choice
        options: [dev, staging, production]
      terraform_action:
        description: Terraform action
        required: true
        default: plan
        type: choice
        options: [plan, apply]

env:
  TF_DIR: souq-local/infra/blueprint/terraform
  AZURE_CLIENT_ID: ${{ secrets.BLUEPRINT_AZURE_CLIENT_ID }}
  AZURE_TENANT_ID: ${{ secrets.BLUEPRINT_AZURE_TENANT_ID }}
  AZURE_SUBSCRIPTION_ID: ${{ secrets.BLUEPRINT_AZURE_SUBSCRIPTION_ID }}

jobs:
  security-scan:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Gitleaks
        uses: gitleaks/gitleaks-action@v2
      - name: Checkov Terraform
        uses: bridgecrewio/checkov-action@master
        with:
          directory: souq-local/infra/blueprint/terraform
      - name: Trivy filesystem
        uses: aquasecurity/trivy-action@master
        with:
          scan-type: fs
          scan-ref: souq-local

  backend-ci:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_USER: souq
          POSTGRES_PASSWORD: souq_local_dev
          POSTGRES_DB: souq_local
        ports: ["5432:5432"]
    defaults:
      run:
        working-directory: souq-local/backend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install -r requirements-dev.txt
      - run: pytest -q
        env:
          DATABASE_URL: postgresql+asyncpg://souq:souq_local_dev@localhost:5432/souq_local
          JWT_SECRET_KEY: test-jwt-secret-key-minimum-32-characters-long

  container-build:
    needs: [security-scan, backend-ci]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build API image
        run: docker build -t margem-api:${{ github.sha }} souq-local/backend
      - name: Trivy image scan
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: margem-api:${{ github.sha }}
          severity: CRITICAL,HIGH
      - name: Generate SBOM
        uses: anchore/sbom-action@v0
        with:
          image: margem-api:${{ github.sha }}

  terraform:
    needs: [container-build]
    runs-on: ubuntu-latest
    environment: blueprint-${{ inputs.environment }}
    defaults:
      run:
        working-directory: ${{ env.TF_DIR }}
    steps:
      - uses: actions/checkout@v4
      - uses: azure/login@v2
        with:
          client-id: ${{ env.AZURE_CLIENT_ID }}
          tenant-id: ${{ env.AZURE_TENANT_ID }}
          subscription-id: ${{ env.AZURE_SUBSCRIPTION_ID }}
      - uses: hashicorp/setup-terraform@v3
      - run: terraform init
      - run: terraform plan -var-file=environments/${{ inputs.environment }}.tfvars -out=tfplan
      - if: inputs.terraform_action == 'apply'
        run: terraform apply -auto-approve tfplan

  smoke-test:
    needs: [terraform]
    if: inputs.terraform_action == 'apply'
    runs-on: ubuntu-latest
    steps:
      - run: |
          curl -sf "${{ vars.BLUEPRINT_API_URL }}/health"
          curl -sf "${{ vars.BLUEPRINT_API_URL }}/ready"

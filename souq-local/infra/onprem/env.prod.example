# Copy to .env.prod — never commit real values.

# --- Domain ---
PUBLIC_APP_URL=https://dribex.ma
PUBLIC_API_URL=https://api.dribex.ma
MINIO_PUBLIC_URL=https://api.dribex.ma/storage
ALLOWED_HOSTS=api.dribex.ma,dribex.ma,www.dribex.ma,qr.dribex.ma
CORS_ORIGINS=https://dribex.ma,https://www.dribex.ma
NEXT_PUBLIC_LAUNCH_CITIES=Casablanca

# --- PostgreSQL ---
POSTGRES_USER=margem
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=margem

# --- API secrets (32+ chars each, must differ) ---
JWT_SECRET_KEY=CHANGE_ME_MIN_32_CHAR_JWT_SECRET_KEY_32CHARS
UPLOAD_TOKEN_SECRET=CHANGE_ME_SEPARATE_32_CHAR_UPLOAD_TOKEN_SECRET
MFA_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
REWARDED_AD_SIGNING_SECRET=<generate-with-openssl-rand-hex-32>

# --- MinIO ---
MINIO_ROOT_USER=margem-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_BUCKET=margem-media

# --- Monetization (initial launch) ---
PAYMENTS_ENABLED=false
SUBSCRIPTIONS_ENABLED=false
ADS_ENABLED=true
REWARDED_ADS_ENABLED=false
PAYMENT_PROVIDER=none

# --- Email (Brevo API — required in production) ---
EMAIL_PROVIDER=brevo
BREVO_API_KEY=CHANGE_ME_BREVO_API_KEY
BREVO_SENDER_EMAIL=noreply@dribex.ma
BREVO_SENDER_NAME=Dribex
EMAIL_REPLY_TO=support@dribex.ma
ALLOW_INSECURE_EMAIL_FALLBACK=false

# --- Future NAPS ePay (inactive while PAYMENTS_ENABLED=false) ---
# PAYMENT_PROVIDER=naps
# NAPS_ENVIRONMENT=sandbox
# NAPS_MERCHANT_ID=
# NAPS_API_KEY=
# NAPS_SECRET_KEY=
# NAPS_WEBHOOK_SECRET=
# NAPS_EPAY_PAYMENT_INIT_URL=
# NAPS_EPAY_PAYMENT_STATUS_URL=

# --- Monitoring (optional) ---
SENTRY_DSN=
APPLICATIONINSIGHTS_CONNECTION_STRING=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# --- Rate limits ---
RATE_LIMIT=300/minute
AUTH_RATE_LIMIT=30/minute

# --- Reverse proxy / admin network ---
TRUSTED_PROXY_HOPS=1
ADMIN_IP_ALLOWLIST=YOUR_OFFICE_OR_VPN_CIDR
ADMIN_REQUIRE_STAFF_MFA=true
SERVE_EMBEDDED_ADMIN=false
# Admin UI (localhost-only bind). Access via SSH tunnel: ssh -L 8080:127.0.0.1:8080 user@server
ADMIN_PORT=8080

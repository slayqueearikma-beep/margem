# Copy to .env.prod — never commit real values.

# --- Domain ---
PUBLIC_APP_URL=https://margem.ma
PUBLIC_API_URL=https://api.margem.ma
MINIO_PUBLIC_URL=https://api.margem.ma/storage
ALLOWED_HOSTS=api.margem.ma,margem.ma
CORS_ORIGINS=["https://margem.ma"]

# --- PostgreSQL ---
POSTGRES_USER=margem
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=margem

# --- API secrets (32+ chars each, must differ) ---
JWT_SECRET_KEY=CHANGE_ME_MIN_32_CHAR_JWT_SECRET_KEY_32CHARS
UPLOAD_TOKEN_SECRET=CHANGE_ME_SEPARATE_32_CHAR_UPLOAD_TOKEN_SECRET

# --- MinIO ---
MINIO_ROOT_USER=margem-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_BUCKET=margem-media

# --- Email (required in production) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=MarGem <noreply@margem.ma>

# --- NAPS ePay (production payments for Dribex services) ---
PAYMENT_PROVIDER=naps
PAYMENT_CURRENCY=mad
NAPS_ENVIRONMENT=production
NAPS_MERCHANT_ID=
NAPS_API_KEY=
NAPS_SECRET_KEY=
NAPS_WEBHOOK_SECRET=
NAPS_EPAY_PAYMENT_INIT_URL=
NAPS_EPAY_PAYMENT_STATUS_URL=
NAPS_WEBHOOK_SIGNATURE_HEADER=X-NAPS-Signature

# --- Monitoring ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# --- Rate limits ---
RATE_LIMIT=300/minute
AUTH_RATE_LIMIT=30/minute

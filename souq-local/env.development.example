# Development — local machine / emulator
# Copy to souq-local/backend/.env (never commit)

APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://souq:souq_local_dev@localhost:5432/souq_local
JWT_SECRET_KEY=local-dev-secret-change-in-production-min-32-chars
UPLOAD_TOKEN_SECRET=local-upload-secret-change-in-production-min-32
STORAGE_PROVIDER=local
LOCAL_MEDIA_ROOT=./data/media
PUBLIC_API_URL=http://127.0.0.1:8000
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8080
ALLOWED_HOSTS=*
PAYMENT_PROVIDER=manual
ALLOW_MANUAL_BILLING=true
AUTH_DEV_BYPASS=false
QR_PUBLIC_BASE_URL=http://127.0.0.1:8000

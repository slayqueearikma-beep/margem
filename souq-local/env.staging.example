# Staging — pre-production validation
# Copy to .env.staging on staging server (never commit)

APP_ENV=staging
DEBUG=false
DATABASE_URL=postgresql+asyncpg://margem:CHANGE_ME@postgres:5432/margem_staging
JWT_SECRET_KEY=CHANGE_ME_STAGING_JWT_32_CHARS_MINIMUM
UPLOAD_TOKEN_SECRET=CHANGE_ME_STAGING_UPLOAD_SECRET_32_CHARS
MFA_ENCRYPTION_KEY=CHANGE_ME_STAGING_MFA_KEY_32_CHARS
STORAGE_PROVIDER=selfhosted
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_PUBLIC_URL=https://api-staging.dribex.ma/storage
PUBLIC_API_URL=https://api-staging.dribex.ma
PUBLIC_APP_URL=https://staging.dribex.ma
QR_PUBLIC_BASE_URL=https://qr-staging.dribex.ma
CORS_ORIGINS=https://staging.dribex.ma
ALLOWED_HOSTS=api-staging.dribex.ma,staging.dribex.ma
PAYMENT_PROVIDER=naps
NAPS_ENVIRONMENT=sandbox
NAPS_MERCHANT_ID=
NAPS_API_KEY=
NAPS_SECRET_KEY=
NAPS_WEBHOOK_SECRET=
EMAIL_PROVIDER=brevo
BREVO_API_KEY=CHANGE_ME_STAGING_BREVO_API_KEY
BREVO_SENDER_EMAIL=noreply@dribex.ma
BREVO_SENDER_NAME=Dribex
EMAIL_REPLY_TO=support@dribex.ma
ALLOW_INSECURE_EMAIL_FALLBACK=false
ADMIN_IP_ALLOWLIST=10.0.0.0/8
SENTRY_DSN=
FREE_SELLER_VIDEO_LIMIT=5

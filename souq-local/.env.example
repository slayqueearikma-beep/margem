# Docker Compose environment for souq-local (copy to .env)
#
# Web and mobile must use the SAME API instance and database.
# Replace 100.80.43.124 with your machine LAN or Tailscale IP.

# Public URLs — used for media links, CORS, and browser-facing API proxy targets
WEB_PUBLIC_SITE_URL=http://100.80.43.124:3000
WEB_PUBLIC_API_URL=http://100.80.43.124:8000

# Include every browser origin that loads the website (Tailscale, LAN, localhost)
CORS_ORIGINS=["http://100.80.43.124:3000","http://127.0.0.1:3000","http://localhost:3000","http://100.80.43.124:8000","http://127.0.0.1:8000","http://localhost:8000"]

# Home dev without Brevo: OTP and reset codes are logged by the API container.
EMAIL_PROVIDER=log
ALLOW_INSECURE_EMAIL_FALLBACK=true

# --- Database (optional overrides) ---
# Default compose stack uses souq_local. If your mobile app already uses the home-server
# margem database, point both api and postgres at the same credentials/volume instead of
# running a second database:
#
# POSTGRES_USER=margemadmin
# POSTGRES_PASSWORD=your_existing_password
# POSTGRES_DB=margem
# DATABASE_URL=postgresql+asyncpg://margemadmin:your_existing_password@postgres:5432/margem
#
# Prefer one compose file for api + web + postgres (docker compose up -d --build web api).

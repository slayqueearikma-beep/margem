# Copy to .env.home and fill in (never commit .env.home)

POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
JWT_SECRET_KEY=CHANGE_ME_MIN_32_CHAR_JWT_SECRET_KEY_32CHARS
# Must be a different random 32+ character value than JWT_SECRET_KEY.
UPLOAD_TOKEN_SECRET=CHANGE_ME_SEPARATE_32_CHAR_UPLOAD_TOKEN_SECRET

# local = store images on the laptop (recommended for home). azure = Azure Blob.
STORAGE_BACKEND=local

# Required for local (and for Azure public URLs in the app). Use your laptop LAN IP.
# Example: http://192.168.11.103:8000
PUBLIC_API_URL=http://192.168.11.103:8000
PUBLIC_APP_URL=http://192.168.11.103:8000

# Only needed when STORAGE_BACKEND=azure
# From: terraform -chdir=infra/terraform-storage output -raw storage_connection_string
# Keep the whole value in double quotes (contains ; characters).
AZURE_STORAGE_CONNECTION_STRING=

# Prefer comma-separated hosts (no ports). Starlette strips ports from Host headers.
# Example for laptop IP 192.168.11.103:
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.11.103
# Include both API and admin dashboard origins (comma-separated, no JSON brackets).
CORS_ORIGINS=http://192.168.11.103:8000,http://192.168.11.103:8080

# Auth was previously 5/minute and blocked normal register/login retries.
AUTH_RATE_LIMIT=30/minute
RATE_LIMIT=300/minute

# Home LAN: no SMTP required when true (verification/reset tokens logged server-side only).
ALLOW_INSECURE_EMAIL_FALLBACK=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=MarGem <noreply@margem.ma>

API_PORT=8000
ADMIN_PORT=8080

# --- Admin dashboard security (separate container on ADMIN_PORT) ---
# HTTP Basic Auth gate before MarGem login (strongly recommended).
ADMIN_BASIC_AUTH_USER=margem
ADMIN_BASIC_AUTH_PASSWORD=CHANGE_ME_ADMIN_GATE_PASSWORD
# Only allow private LAN IPs (192.168/10/172.16). Set true only if exposing admin publicly.
ADMIN_ALLOW_PUBLIC=false
# Optional extra CIDRs, e.g. VPN: 10.8.0.0/24
ADMIN_EXTRA_ALLOWED_CIDRS=
# Require staff/admin accounts to enable MFA before using admin APIs.
ADMIN_REQUIRE_STAFF_MFA=true

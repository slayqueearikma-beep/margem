# Copy to .env.home and fill in (never commit .env.home)

POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
JWT_SECRET_KEY=CHANGE_ME_MIN_32_CHAR_JWT_SECRET_KEY

# From: terraform -chdir=infra/terraform-storage output -raw storage_connection_string
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# Your laptop LAN IP + Tailscale IP (if used). JSON arrays — no wildcards.
# Include localhost for curl on the laptop + your LAN IP for phone access.
# Example: ["localhost","127.0.0.1","192.168.1.50","192.168.1.50:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","192.168.1.50","192.168.1.50:8000"]
CORS_ORIGINS=["http://192.168.1.50:8000"]

API_PORT=8000

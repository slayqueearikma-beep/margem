# Optional overrides for docker compose (copy to souq-local/.env)
# LAN example — replace 192.168.11.104 with your server IP

WEB_PUBLIC_API_URL=http://192.168.11.104:8000
WEB_PUBLIC_SITE_URL=http://192.168.11.104:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://192.168.11.104:3000","http://192.168.11.104:8000","http://localhost:8000","http://localhost:8080"]

# Use the same database credentials as your mobile/home-server API (do not create a second DB):
# POSTGRES_USER=margemadmin
# POSTGRES_PASSWORD=...
# POSTGRES_DB=margem
# DATABASE_URL=postgresql+asyncpg://margemadmin:...@postgres:5432/margem
